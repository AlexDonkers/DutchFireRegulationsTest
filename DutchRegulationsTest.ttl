    fro:hasParagraph fbr:NL-RO-OmW-BBL-4-4.2-4.2.10,
        fbr:NL-RO-OmW-BBL-4-4.2-4.2.11,
        fbr:NL-RO-OmW-BBL-4-4.2-4.2.12,
        fbr:NL-RO-OmW-BBL-4-4.2-4.2.13,
        fbr:NL-RO-OmW-BBL-4-4.2-4.2.14,
